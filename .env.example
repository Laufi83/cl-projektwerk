# Render Free needs no credentials. Do not upload real .env files to GitHub.
NEXT_PUBLIC_CONTACT_MODE=mailto
NEXT_PUBLIC_INDEXING=false
NEXT_PUBLIC_MEDIA_BASE=/media
# Render's assigned onrender.com URL is detected by build:render.
# Optional custom domain; rebuild after setting:
# NEXT_PUBLIC_SITE_URL=https://www.cl-projektwerk.de

# SMTP delivery is preserved only as an optional mode for a compatible host.
# Render Free blocks standard SMTP ports, so keep mailto for this package.
# NEXT_PUBLIC_CONTACT_MODE=smtp
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# MAIL_TO=
